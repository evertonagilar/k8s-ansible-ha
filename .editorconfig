# Arquivo .editorconfig para Ansible

# Configurações padrão para todos os arquivos
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Configurações específicas para arquivos YAML usados no Ansible
[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

# Configurações específicas para arquivos JSON
[*.json]
indent_style = space
indent_size = 2

# Configurações específicas para arquivos de texto e Markdown
[*.md]
trim_trailing_whitespace = false

[*.txt]
trim_trailing_whitespace = false
